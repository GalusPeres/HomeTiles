                  <input type="file" id="settings_tile_import" accept="application/json" style="display:none" onchange="importTilesConfig('settings', this.files)">
                  <button type="button" class="btn" onclick="triggerTilesImport('settings')">␀</div>
              </div>
            </div>
          </div>

          <div class="settings-section">
            <div class="section-title">␀␀␀</div>
            <div class="settings-grid">
              <div class="settings-full">
                <div class="settings-note"><strong>␀␀␀␀:</strong></div>
                <div class="settings-note ota-version-value">␀␀</div>
                <div class="settings-note"><strong>GitHub OTA:</strong></div>
                <div class="settings-actions ota-github-actions">
                  <button class="btn btn-go" type="button" id="ota_github_btn" onclick="checkOrInstallGithubFirmware()">␀</button>
                </div>
                <div id="ota_github_status" class="settings-note ota-status"></div>
                <div id="ota_github_progress" class="ota-progress is-hidden" aria-hidden="true">
                  <div id="ota_github_progress_bar" class="ota-progress-bar"></div>
                </div>
                <div class="settings-note"><strong>␀␀␀␀:</strong></div>
                <input type="file" id="ota_file" accept=".bin,application/octet-stream" style="display:none" onchange="updateOtaFileName(this)">
                <div class="file-picker">
                  <button class="btn btn-secondary btn-inline" type="button" id="ota_choose_btn" onclick="document.getElementById('ota_file').click()">␀</button>
                  <button class="btn btn-go btn-inline" type="button" id="ota_upload_btn" onclick="uploadOtaFirmware()">␀␀</button>
                  <span id="ota_file_name" class="file-picker-name">␀␀</span>
                </div>
                <div id="ota_status" class="settings-note ota-status"></div>
                <div id="ota_progress" class="ota-progress is-hidden" aria-hidden="true">
                  <div id="ota_progress_bar" class="ota-progress-bar"></div>
                </div>
                <div class="settings-note">␀␀␀</div>
              </div>
            </div>
          </div>
        </form>

        <form id="admin_restart_form" action="/restart" method="POST" onsubmit="return confirm('GerГ¤t wirklich neu starten?');" class="admin-hidden-form"></form>
        <div class="admin-footer-actions">
          <button class="btn btn-go admin-footer-btn" type="submit" form="admin_settings_form">Speichern</button>
          <button class="btn btn-secondary admin-footer-btn" type="submit" form="admin_restart_form">GerГ¤t neu starten</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Notification Toast -->
  <div id="notification" class="notification" role="status" aria-live="polite"></div>
</body>
</html>
