      src:url('/assets/inter-4.1-regular.woff2') format('woff2');
      font-style:normal;
      font-weight:400;
      font-display:swap;
    }
    @font-face {
      font-family:'HomeTiles Inter';
      src:url('/assets/inter-4.1-regular.woff2') format('woff2');
      font-style:normal;
      font-weight:500;
      font-display:swap;
    }
    @font-face {
      font-family:'HomeTiles Inter';
      src:url('/assets/inter-4.1-semibold.woff2') format('woff2');
      font-style:normal;
      font-weight:600;
      font-display:swap;
    }
    @font-face {
      font-family:'HomeTiles Inter';
      src:url('/assets/inter-4.1-semibold.woff2') format('woff2');
      font-style:normal;
      font-weight:700;
      font-display:swap;
    }
